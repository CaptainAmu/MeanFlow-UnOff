#!/bin/bash
#SBATCH -N 1
#SBATCH --job-name=mf_train
#SBATCH --output=joblogs/%j_train_out.txt
#SBATCH --error=joblogs/%j_train_err.txt
#SBATCH --time=02:00:00
#SBATCH --mem=32000
#SBATCH --gres=gpu:1
#SBATCH --qos=short
#SBATCH --partition=normal

# MeanFlow-UnOff training (CIFAR-10 or MNIST) - 4 GPUs on normal partition
# Normal partition nodes (gauss, klein, noether) have 4 GPUs each.
# Edit train.py for dataset (MNIST or CIFAR10) and n_steps before submitting.

export PYTHONNOUSERSITE=1

PROJECT_ROOT=/slurm-storage/shucli/PROJECT_FOLDER/MF_DMD_CIFAR10
MF_ROOT=/slurm-storage/shucli/PROJECT_FOLDER/MF_DMD_CIFAR10/MF
TRAIN_DIR="$MF_ROOT/Train"
cd "$TRAIN_DIR"
# Project root for models.dit; Train dir for meanflow, config
export PYTHONPATH="$PROJECT_ROOT:$TRAIN_DIR:$PYTHONPATH"
mkdir -p joblogs "$MF_ROOT/images" "$MF_ROOT/checkpoints"

# Use accelerate for multi-GPU (4 GPUs = ~4x speedup)
ACCELERATE=/slurm-storage/shucli/.conda/envs/meanflow/bin/accelerate

srun -u "$ACCELERATE" launch --multi_gpu --num_processes 4 \
    --mixed_precision fp16 \
    --main_process_port 29500 \
    train.py --output_dir "$MF_ROOT"

echo "Done! Check joblogs/ for output. Checkpoints in $MF_ROOT/checkpoints/."