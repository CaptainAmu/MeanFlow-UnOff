#!/bin/bash
#SBATCH -N 1
#SBATCH --job-name=fm_teacher
#SBATCH --output=joblogs/%j_train_out.txt
#SBATCH --error=joblogs/%j_train_err.txt
#SBATCH --time=06:00:00
#SBATCH --mem=32000
#SBATCH --gres=gpu:1
#SBATCH --qos=medium
#SBATCH --partition=normal

# Flow matching teacher (clean prediction, Reflow/Trig)
# Edit train_teacher.yml for flow_schedule (Reflow|Trig) and dataset.
# To resume: RESUME=checkpoints/step_10000.pt sbatch train_teacher.job

export PYTHONNOUSERSITE=1

PROJECT_ROOT=/slurm-storage/shucli/PROJECT_FOLDER/MF_DMD_CIFAR10
FM_ROOT=/slurm-storage/shucli/PROJECT_FOLDER/MF_DMD_CIFAR10/FM
cd "$FM_ROOT"
export PYTHONPATH="$PROJECT_ROOT:$FM_ROOT:$PYTHONPATH"
mkdir -p joblogs "$FM_ROOT/images" "$FM_ROOT/checkpoints"

CONFIG="${CONFIG:-train_teacher.yml}"
RESUME="${RESUME:-}"
PYTHON=/slurm-storage/shucli/.conda/envs/meanflow/bin/python

if [ -n "$RESUME" ]; then
    srun -u "$PYTHON" train_teacher.py --config "$CONFIG" --output_dir "$FM_ROOT" --resume "$RESUME"
else
    srun -u "$PYTHON" train_teacher.py --config "$CONFIG" --output_dir "$FM_ROOT"
fi

echo "Done! Checkpoints in $FM_ROOT/checkpoints/."
