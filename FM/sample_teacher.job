#!/bin/bash
#SBATCH -N 1
#SBATCH --job-name=fm_sample
#SBATCH --output=joblogs/%j_sample_out.txt
#SBATCH --error=joblogs/%j_sample_err.txt
#SBATCH --time=00:30:00
#SBATCH --mem=8000
#SBATCH --gres=gpu:1
#SBATCH --qos=short
#SBATCH --partition=normal

# Sample from FM teacher (Euler ODE)
# Edit sample_teacher.yml for ckpt_path and num_steps, then: sbatch sample_teacher.job
# Or override via env: CKPT=... NUM_STEPS=40 sbatch sample_teacher.job

export PYTHONNOUSERSITE=1

PROJECT_ROOT=/slurm-storage/shucli/PROJECT_FOLDER/MF_DMD_CIFAR10
FM_ROOT=/slurm-storage/shucli/PROJECT_FOLDER/MF_DMD_CIFAR10/FM
cd "$FM_ROOT"
export PYTHONPATH="$PROJECT_ROOT:$FM_ROOT:$PYTHONPATH"
mkdir -p joblogs

CONFIG="${CONFIG:-sample_teacher.yml}"
PYTHON=/slurm-storage/shucli/.conda/envs/meanflow/bin/python

EXTRA=""
[ -n "$CKPT" ] && EXTRA="$EXTRA --ckpt $CKPT"
[ -n "$NUM_STEPS" ] && EXTRA="$EXTRA --num_steps $NUM_STEPS"
[ -n "$OUTPUT" ] && EXTRA="$EXTRA --output $OUTPUT"

srun -u "$PYTHON" sample_teacher.py --config "$CONFIG" $EXTRA

echo "Done! Check sample_teacher.yml for output path."